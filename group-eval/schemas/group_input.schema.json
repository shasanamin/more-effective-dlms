{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/groupeval/group_input.schema.json",
  "title": "GroupEval blinded group input",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "group_id", "target_profile_id", "samples"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "group_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "target_profile_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "text"],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
